    "GymMember": {
      "title": "Gym Member",
      "description": "A member of the gym with personal and membership details.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string" },
        "nationality": { "type": "string" },
        "level": { "type": "string", "enum": ["Novice", "Intermediate", "Expert"] },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "allergies": { "type": "string" },
        "healthProblems": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "packageId": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "billingStatus": { "type": "string", "enum": ["paid", "unpaid"] },
        "addons": { "type": "array", "items": { "type": "string" } },
        "totalPaid": { "type": "number" },
        "expectedFee": { "type": "number" },
        "qrCode": { "type": "string" },
        "uid": { "type": "string", "description": "The UID of the user who created this member record." }
      },
      "required": ["firstName", "lastName", "phone", "packageId", "startDate", "expiryDate", "uid"]
    },
    "GymPackage": {
      "title": "Gym Package",
      "description": "A membership package offered by the gym.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "duration": { "type": "number", "description": "Duration in months" },
